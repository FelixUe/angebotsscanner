# Kopieren nach .env, ausfüllen, chmod 600. Die .env gehört nie ins Repository.

# Postleitzahl für regionale Prospekte (überschreibt standort.plz)
ANGEBOTSSCANNER_PLZ=

# Lokal ohne Container: eigene Dateien statt der Beispielkonfiguration
# ANGEBOTSSCANNER_CONFIG=./config.yaml
# ANGEBOTSSCANNER_VORRAT=./vorrat.yaml

# Mealie. Eigenes API-Token anlegen:
# Mealie → Profil → API-Tokens → Name „Angebotsscanner“.
MEALIE_URL=http://mealie:9000
MEALIE_TOKEN=
