# Kopieren nach .env, ausfüllen, chmod 600. Die .env gehört nie ins Repository.

# Postleitzahl für regionale Prospekte (überschreibt standort.plz)
ANGEBOTSSCANNER_PLZ=

# Aktive Quellen (leer = wie in der config). Marktguru ist inoffiziell und
# deshalb in der Beispielkonfiguration aus.
ANGEBOTSSCANNER_QUELLEN=marktguru,aldi_nord

# Lokal ohne Container: eigene Dateien statt der Beispielkonfiguration
# ANGEBOTSSCANNER_CONFIG=./config.yaml
# ANGEBOTSSCANNER_VORRAT=./vorrat.yaml

# Mealie. Eigenes API-Token anlegen:
# Mealie → Profil → API-Tokens → Name „Angebotsscanner“.
MEALIE_URL=http://mealie:9000
MEALIE_TOKEN=

# Optional: Zusammenfassung je Lauf an Home Assistant (Webhook, kein Token nötig).
# Die Webhook-ID wie ein Passwort behandeln.
HA_WEBHOOK_URL=

# Optional: Lauf auf Zuruf, z. B. vom Essensplaner, sobald der Zettel fertig ist.
# Zufallswert, z. B. `openssl rand -hex 32`; derselbe Wert steht beim Aufrufer.
ANGEBOTSSCANNER_AUSLOESER_TOKEN=
